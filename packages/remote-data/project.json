{
  "name": "remote-data",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/remote-data",
  "projectType": "library",
  "tags": ["lib", "lib:remote-data"],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/package"],
      "options": {
        "main": "packages/remote-data/src/index.ts",
        "outputPath": "dist/packages/remote-data/package",
        "generatePackageJson": true,
        "tsConfig": "packages/remote-data/tsconfig.lib.json",
        "format": ["esm", "cjs"],
        "assets": [
          "packages/remote-data/package.json",
          "packages/remote-data/README.md",
          "packages/remote-data/CHANGELOG.md"
        ]
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/publish.mjs {args.tag} {args.verbose}"
      },
      "dependsOn": [
        {
          "target": "build"
        }
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "tsConfig": "packages/remote-data/tsconfig.spec.json",
        "karmaConfig": "packages/remote-data/karma.conf.js",
        "polyfills": ["zone.js", "zone.js/testing"]
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "conventional"
      }
    }
  }
}
